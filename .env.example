# ==========================================
# Backend Configuration (Render / Railway / Docker)
# ==========================================
# PostgreSQL connection string (supports Neon.tech, Supabase, Render, Railway, etc.)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/memeswipe

# Google Gemini API Key for Persona Chat & AI Humor Analyst
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Frontend Origins for CORS (comma-separated or JSON array)
# e.g. https://memeswipe.vercel.app,http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# Meme API endpoint (default: https://meme-api.com)
MEME_API_BASE_URL=https://meme-api.com

# ==========================================
# Frontend Configuration (Vercel / Cloudflare)
# ==========================================
# URL of your deployed backend API (leave empty for local dev proxy)
# e.g. https://memeswipe-api.onrender.com
VITE_API_URL=
